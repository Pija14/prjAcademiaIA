# Choose exactly one provider: gemini or openai
AI_PROVIDER=gemini
GEMINI_API_KEY=
OPENAI_API_KEY=

# Comma-separated origins. Add your actual GitHub Pages URL before deployment.
ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,https://SEU_USUARIO.github.io

# Optional model overrides
GEMINI_MODEL=gemini-flash-latest
# Tentados em ordem se o modelo principal estiver indisponível:
GEMINI_FALLBACK_MODELS=gemini-flash-latest,gemini-3-flash-preview
OPENAI_MODEL=gpt-5-mini

